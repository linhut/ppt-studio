id: "02_toc"
pageType: "toc"
background:
  color: "#f5f5f5"          # $bg 内联
elements:
  - elementType: "text"
    bounds: [40, 50, 400, 60]
    content:
      text: "<p>目录</p>"
      align: ["left", "middle"]
      style: "$title"
# 卡片 1（其余卡片：x 依次 +280，行 y 150/280/410）
  - elementType: "shape"
    shapeName: "roundRect"
    bounds: [40, 150, 260, 110]
    fill: { type: "solid", color: "$paper" }
    border: { style: "solid", color: "$line", width: 1 }
  - elementType: "text"
    bounds: [60, 168, 80, 40]
    content:
      text: "<p>01</p>"
      align: ["left", "middle"]
      style: "$stat"
  - elementType: "text"
    bounds: [115, 178, 180, 35]
    content:
      text: "<p>章节一标题</p>"
      align: ["left", "middle"]
      style: "$h3"
  - elementType: "text"
    bounds: [60, 212, 220, 30]
    content:
      text: "<p>一句话说明</p>"
      align: ["left", "middle"]
      style: "$muted"
