{
  "theme": {
    "colors": {
      "$bg": "#FFFFFF",
      "$paper": "#F5F7FA",
      "$primary": "#0B3D91",
      "$accent": "#2E6BB0",
      "$text": "#1A1A1A",
      "$muted": "#6B7280",
      "$line": "#E5E7EB",
      "$ink": "#0B3D91",
      "$green": "#1E7B4F",
      "$brass": "#A67C00"
    }
  },
  "slides": [
    {
      "id": "s01", "title": "封面",
      "elements": [
        {"type": "rect", "x": 0, "y": 0, "w": 960, "h": 5, "fill": {"color": "$primary"}},
        {"type": "rect", "x": 0, "y": 535, "w": 960, "h": 5, "fill": {"color": "$primary"}},
        {"type": "text", "x": 90, "y": 120, "w": 780, "h": 32, "role": "caption", "text": "PPT-STUDIO · 布局样式库", "color": "$accent", "bold": true},
        {"type": "text", "x": 90, "y": 168, "w": 780, "h": 64, "role": "title", "text": "十种新排版样式展示", "color": "$ink"},
        {"type": "text", "x": 90, "y": 252, "w": 700, "h": 30, "role": "body", "text": "吸收 html-ppt、MiniMax、GordenPPTSkill、harness-anything 的版式精华", "color": "$muted"},
        {"type": "text", "x": 90, "y": 460, "w": 500, "h": 24, "role": "caption", "text": "2025 · ppt-studio 引擎 v3", "color": "$muted"}
      ]
    },
    {
      "id": "s02", "title": "分隔页（左侧色块）",
      "elements": [
        {"type": "section_divider", "num": "01", "title": "设计系统", "intro": "色彩 · 字体 · 间距的统一规范", "variant": "leftaccent"}
      ]
    },
    {
      "id": "s03", "title": "左右对比",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "两套方案对比", "color": "$ink"},
        {"type": "comparison_2col",
         "left": {"title": "方案 A：轻量", "points": ["上手快，成本低", "适合小团队快速验证", "扩展性一般"]},
         "right": {"title": "方案 B：完整", "points": ["能力强，覆盖全场景", "适合长期演进", "初期投入较高"]}}
      ]
    },
    {
      "id": "s04", "title": "横向时间线",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "项目里程碑", "color": "$ink"},
        {"type": "timeline_h",
         "items": [
           {"time": "Q1", "title": "需求调研", "desc": "完成用户访谈与竞品分析"},
           {"time": "Q2", "title": "原型设计", "desc": "输出核心流程与视觉稿"},
           {"time": "Q3", "title": "开发测试", "desc": "功能开发与质量保障"},
           {"time": "Q4", "title": "发布上线", "desc": "全量发布并跟踪指标"}
         ]}
      ]
    },
    {
      "id": "s05", "title": "流程步骤",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "内容生产流程", "color": "$ink"},
        {"type": "process_steps",
         "steps": [
           {"title": "收集素材", "desc": "调研资料与数据"},
           {"title": "确定大纲", "desc": "结构化组织内容"},
           {"title": "撰写内容", "desc": "逐页填充与打磨"},
           {"title": "编译检查", "desc": "排版质量自动化"}
         ]}
      ]
    },
    {
      "id": "s06", "title": "KPI 横排",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "核心运营指标", "color": "$ink"},
        {"type": "kpi_row",
         "items": [
           {"num": "208万", "label": "月活用户", "delta": "+12%"},
           {"num": "42%", "label": "留存率", "delta": "+3.1pt"},
           {"num": "96.8%", "label": "满意度", "delta": "+1.2pt"},
           {"num": "31万", "label": "新增装机", "delta": "−8%"}
         ]}
      ]
    },
    {
      "id": "s07", "title": "利弊两卡",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "方案权衡", "color": "$ink"},
        {"type": "pros_cons",
         "pros": ["专注核心，交付更快", "技术栈统一，维护简单", "团队已有扎实经验"],
         "cons": ["定制化能力有限", "边缘场景覆盖不足", "后续扩展需重构"]}
      ]
    },
    {
      "id": "s08", "title": "大引语",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "设计理念", "color": "$ink"},
        {"type": "big_quote", "quote": "好的设计不是堆砌装饰，而是让观众三秒内读懂重点。", "author": "ppt-studio 设计原则"}
      ]
    },
    {
      "id": "s09", "title": "路线图四列",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "产品路线图", "color": "$ink"},
        {"type": "roadmap_4col",
         "columns": [
           {"phase": "NOW", "items": ["核心功能打磨", "性能优化", "文档完善"]},
           {"phase": "NEXT", "items": ["模板市场", "协作能力", "多语言"]},
           {"phase": "LATER", "items": ["AI 智能排版", "插件生态"]},
           {"phase": "VISION", "items": ["人人可用的创作平台"]}
         ]}
      ]
    },
    {
      "id": "s10", "title": "清单页",
      "elements": [
        {"type": "text", "x": 60, "y": 40, "w": 700, "h": 40, "role": "title", "text": "发布前检查清单", "color": "$ink"},
        {"type": "checklist",
         "items": [
           {"text": "逐页核对文案与数据无误", "done": true},
           {"text": "字号层级符合设计规范", "done": true},
           {"text": "配色仅用主色 + 强调色 + 黑白灰", "done": true},
           {"text": "容量检查无溢出警告", "done": true},
           {"text": "导出 PPTX 后在 PowerPoint 打开验证", "done": false},
           {"text": "演讲者备注补齐逐字稿", "done": false}
         ]}
      ]
    },
    {
      "id": "s11", "title": "非对称封面样式",
      "elements": [
        {"type": "cover_asym", "kicker": "PPT-STUDIO · 备选封面", "title": "非对称封面布局", "subtitle": "左文右色块，视觉重心明确", "meta": "2025 · 布局样式库"}
      ]
    },
    {
      "id": "s12", "title": "结尾",
      "elements": [
        {"type": "rect", "x": 0, "y": 0, "w": 960, "h": 5, "fill": {"color": "$primary"}},
        {"type": "rect", "x": 0, "y": 535, "w": 960, "h": 5, "fill": {"color": "$primary"}},
        {"type": "text", "x": 90, "y": 200, "w": 780, "h": 60, "role": "title", "text": "谢谢观看", "color": "$ink", "align": "center"},
        {"type": "text", "x": 90, "y": 280, "w": 780, "h": 30, "role": "body", "text": "更多排版样式持续吸收优秀技能中", "color": "$muted", "align": "center"}
      ]
    }
  ]
}
